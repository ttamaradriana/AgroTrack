<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐄"
            android:textSize="32sp"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vaca Lechera"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"/>

            <TextView
                android:id="@+id/tvSubtituloItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cantidad: 25 | Vacuna: Brucelosis"
                android:textSize="14sp"
                android:textColor="#424242"/>

            <TextView
                android:id="@+id/tvDetalleExtra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comida: Forraje y alfalfa"
                android:textSize="13sp"
                android:textColor="#616161"/>
        </LinearLayout>
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbTareaMañana"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Alimetación - Mañana"
        android:textColor="#2E7D32"
        android:textStyle="bold"/>

    <CheckBox
        android:id="@+id/cbTareaTarde"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Alimetación -Tarde"
        android:textColor="#2E7D32"
        android:textStyle="bold"/>

    <CheckBox
        android:id="@+id/cbVacuna"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Mañana - Alimetación"
        android:textColor="#2E7D32"
        android:textStyle="bold"/>
</LinearLayout>